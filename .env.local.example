# ── Tagger provider ────────────────────────────────────────────────────────────
# Which AI backend to use for auto-tagging.
# Options: "claude" (default) | "ollama"
TAGGER_PROVIDER=claude

# ── Claude (Anthropic) ─────────────────────────────────────────────────────────
# Required when TAGGER_PROVIDER=claude.
# Get your key at https://console.anthropic.com/settings/keys
# Note: Claude API credits are separate from a Claude Pro subscription.
ANTHROPIC_API_KEY=sk-ant-...

# Model to use for Claude tagging (default: claude-haiku-4-5)
# Cheaper/faster options : claude-haiku-4-5
# Higher quality options : claude-opus-4-8
TAGGER_MODEL=claude-haiku-4-5

# ── Ollama (local model) ───────────────────────────────────────────────────────
# Required when TAGGER_PROVIDER=ollama.
# Ollama must be running locally: https://ollama.com
#
# Base URL of the Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Vision-capable model to use (default: llava)
# Pull a model first:  ollama pull llava
# Other options: llava:13b, moondream, bakllava
OLLAMA_MODEL=llava
